# Dependencies
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# Test run output (regenerated on every run - see CLAUDE.md "Report freshness")
reports/
test-results/
playwright-report/
blob-report/
.playwright-mcp/
*.webm
*.zip

# Playwright browser/cache artifacts
.cache/
playwright/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / tooling local state
.claude/settings.local.json
.vscode/*
!.vscode/settings.json
.idea/
*.swp

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Temp / scratch
tmp/
temp/
scratch/
*.tmp
*.bak
*.orig
*.pdf.original

# playwright-bdd generated specs (regenerated by `npm run gen` on every run)
.features-gen/

