{
  "name": "playwright-cucumber-pom-sample",
  "version": "1.0.0",
  "description": "Sample Playwright + TypeScript + Cucumber project using Page Object Model and Mocha reporting",
  "main": "index.js",
  "scripts": {
    "test": "node configs/run-playwright.js",
    "test:parallel": "node configs/run-playwright.js --workers 4 --tags \"not @provision\"",
    "test:headed": "node configs/run-playwright.js --headed",
    "test:rerun": "node configs/run-playwright.js --last-failed",
    "debug:navigate": "npx ts-node ./tests/debug-navigation.ts",
    "playwright:install": "npx playwright install --with-deps",
    "lint": "eslint . --ext .ts",
    "prepare": "npm run playwright:install",
    "reports:clean": "node ./configs/reportsWorkspace.js",
    "reports:clean:dry": "node ./configs/reportsWorkspace.js --dry-run",
    "reports:archive": "node ./configs/reportsWorkspace.js --archive",
    "test:report:pdf": "node scripts/build-summary-report.js --open",
    "report:pdf:rebuild": "node scripts/build-summary-report.js",
    "test:report": "npx playwright show-report reports/playwright-report",
    "test:provision": "node configs/run-playwright.js --profile provision",
    "test:referral": "node configs/run-playwright.js features/Agent_Portal/Referral-Codes.feature",
    "test:invite-agent": "node configs/run-playwright.js --tags \"@invite-agent and not @provision\"",
    "test:invite-agent:provision": "node configs/run-playwright.js --tags \"@invite-agent and @provision\"",
    "test:promo": "node configs/run-playwright.js --profile promo",
    "test:promo-all": "node configs/run-playwright.js --profile promoAll",
    "test:promo:provision": "node ./scripts/provision-promo-agents.js",
    "test:promo:candidates": "node ./scripts/provision-promo-candidates.js",
    "test:promo:repair": "node ./scripts/repair-promo-agents.js",
    "test:not-automatable": "node configs/run-playwright.js --profile notAutomatable",
    "test:promo-usage": "node configs/run-playwright.js --profile promoUsage",
    "test:promo-exhaustion": "node configs/run-playwright.js --profile promoUsage --tags \"@promo-lifecycle and @consumes-promo\"",
    "test:only": "node configs/run-playwright.js --profile only",
    "test:ci": "node configs/run-playwright.js --headless",
    "test:community": "node configs/run-playwright.js --profile community",
    "test:community-admin": "node configs/run-playwright.js --profile community features/SuperAdmin_Portal/Community/Community.feature",
    "test:community-candidate": "node configs/run-playwright.js --profile community features/Candidate_Portal/Community.feature",
    "test:community-create": "node configs/run-playwright.js --profile communityCreate",
    "test:agent": "node configs/run-playwright.js --profile agent",
    "test:in-progress": "node configs/run-playwright.js --profile inProgress",
    "test:agent-mutating": "node configs/run-playwright.js --profile agentMutating",
    "test:agent-row-actions": "node configs/run-playwright.js --profile agentRowActions",
    "test:agent-login-as": "node configs/run-playwright.js --profile agentLoginAs",
    "test:agent-view": "node configs/run-playwright.js --profile agentView",
    "test:agent-view:e2e": "node configs/run-playwright.js --profile agentViewE2E",
    "test:agent-profile-candidates": "node configs/run-playwright.js --profile agentProfileCandidates",
    "test:agent-profile-candidates:e2e": "node configs/run-playwright.js --profile agentProfileCandidatesE2E",
    "test:user-management": "node configs/run-playwright.js --profile userManagement",
    "test:user-management:view-profile": "node configs/run-playwright.js --profile superadminViewProfile",
    "test:user-management:edges": "node configs/run-playwright.js --profile userManagementEdges",
    "test:candidate": "node configs/run-playwright.js --profile candidateManagement",
    "test:candidate-mutating": "node configs/run-playwright.js --profile candidateMutating",
    "test:edit-email": "node configs/run-playwright.js --profile editEmail",
    "test:edit-email:e2e": "node configs/run-playwright.js --profile editEmailE2E",
    "test:agent-emails": "node configs/run-playwright.js --profile agentEmails",
    "test:2fa": "node configs/run-playwright.js --profile twofa",
    "test:2fa:provision": "node ./scripts/provision-2fa-agent.js",
    "test:2fa:reset": "node ./scripts/reset-2fa-agent.js",
    "test:change-password": "node configs/run-playwright.js --profile changePassword",
    "test:change-password:recover": "node ./scripts/recover-changepassword-agent.js",
    "test:doc-verify": "node ./scripts/run-doc-verification.js",
    "test:doc-verify-bdd": "node configs/run-playwright.js --profile docVerify",
    "test:doc-verify:dry": "node ./scripts/run-doc-verification.js --dry-run",
    "test:doc-verify:reset": "node ./scripts/doc-verification-reset.js",
    "test:doc-verify:probe": "node ./scripts/probe-doc-verification.js",
    "test:doc-verify:fixtures": "node ./scripts/make-doc-verification-fixtures.js",
    "test:doc-verify:one": "node configs/run-playwright.js --profile docVerify",
    "test:doc-verify:upload": "node configs/run-playwright.js --profile docVerifyUpload",
    "test:doc-verify:decisions": "node configs/run-playwright.js --profile docVerifyDecisions",
    "test:doc-lifecycle": "node configs/run-playwright.js --profile docLifecycle",
    "test:doc-lifecycle:read-only": "node configs/run-playwright.js --profile docLifecycleReadOnly",
    "test:doc-verify:fast": "node configs/run-playwright.js --profile docVerifyFast",
    "test:doc-verify:ui": "node configs/run-playwright.js --profile docVerifyUi",
    "test:doc-verify:walkthrough": "node configs/run-playwright.js --profile docVerifyWalkthrough",
    "test:welcome-onboarding": "node configs/run-playwright.js --profile welcomeOnboarding",
    "test:welcome-onboarding:provision": "node configs/run-playwright.js --profile welcomeOnboardingProvision",
    "test:candidate-e2e": "node configs/run-playwright.js --profile candidateE2E",
    "test:bulk-upload": "node configs/run-playwright.js --profile bulkUpload",
    "test:bulk-upload:read-only": "node configs/run-playwright.js --profile bulkUploadReadOnly",
    "test:invite-candidate": "node configs/run-playwright.js --profile inviteCandidate",
    "test:invite-candidate:read-only": "node configs/run-playwright.js --profile inviteCandidateReadOnly",
    "gen": "npx bddgen --config configs/playwright.config.js",
    "test:contact-us": "node configs/run-playwright.js --profile contactUs",
    "test:candidate-details": "node configs/run-playwright.js --profile candidateDetails",
    "test:candidate-details:read-only": "node configs/run-playwright.js --profile candidateDetailsReadOnly",
    "test:view-profile": "node configs/run-playwright.js --profile candidateViewProfile",
    "test:view-profile:read-only": "node configs/run-playwright.js --profile candidateViewProfileReadOnly",
    "test:contact-us:read-only": "node configs/run-playwright.js --profile contactUsReadOnly",
    "test:require-attention": "node configs/run-playwright.js --profile requireAttention",
    "test:deactivated": "node configs/run-playwright.js --profile candidateDeactivated",
    "test:agent-analytics": "node configs/run-playwright.js --profile agentAnalytics",
    "test:candidate-analytics": "node configs/run-playwright.js --profile candidateAnalytics",
    "test:activity-log": "node configs/run-playwright.js --profile activityLog",
    "test:agent-settings": "node configs/run-playwright.js --profile agentSettings",
    "test:agent-settings:read-only": "node configs/run-playwright.js --profile agentSettingsReadOnly",
    "test:empty-state": "node configs/run-playwright.js --profile emptyState",
    "test:dashboard": "node configs/run-playwright.js --profile agentDashboard",
    "test:dashboard:read-only": "node configs/run-playwright.js --profile agentDashboardReadOnly",
    "test:verifications": "node configs/run-playwright.js --profile verifications",
    "test:audit-logs": "node configs/run-playwright.js --profile auditLogs",
    "test:headless": "node configs/run-playwright.js --headless",
    "test:serial": "node configs/run-playwright.js --serialise",
    "test:list": "node configs/run-playwright.js --list",
    "check:tags": "node scripts/check-special-tags.js",
    "check:profiles": "node scripts/check-profile-selection.js"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "typescript",
    "pom",
    "mocha",
    "playwright-bdd"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "chai": "^4.3.7",
    "dotenv": "^16.6.1",
    "eslint": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "playwright": "^1.40.0",
    "playwright-bdd": "^9.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dayjs": "^1.11.10",
    "googleapis": "^173.0.0",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "node-fetch": "^2.7.0"
  }
}
